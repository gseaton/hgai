# HypergraphAI Environment Configuration
# Copy this file to .env and edit as needed

# ─── MongoDB ────────────────────────────────────────────────────────────────
HGAI_MONGO_URI=mongodb://admin:pwd357@localhost:27017/hgai?authSource=admin
HGAI_MONGO_DB=hgai

# ─── Security ───────────────────────────────────────────────────────────────
# REQUIRED: Change this to a strong random secret in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HGAI_SECRET_KEY=change-me-to-a-strong-random-secret-key-in-production
HGAI_TOKEN_EXPIRE_MINUTES=480

# ─── API Keys (Machine-to-Machine Auth) ─────────────────────────────────────
# Optional: API keys for MCP clients, AI agents, and automated systems
# API keys grant full admin access without requiring login
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# HGAI_PRIMARY_API_KEY=your-primary-api-key-here
# HGAI_SECONDARY_API_KEY=your-secondary-api-key-for-rotation

# ─── Server ─────────────────────────────────────────────────────────────────
HGAI_HOST=0.0.0.0
HGAI_PORT=8357
HGAI_LOG_LEVEL=info
HGAI_RELOAD=false

# ─── Server Identity (for mesh operations) ──────────────────────────────────
HGAI_SERVER_ID=hgai-local
HGAI_SERVER_NAME=HypergraphAI Local

# ─── Query Cache ────────────────────────────────────────────────────────────
HGAI_CACHE_ENABLED=true
HGAI_CACHE_TTL_SECONDS=300
HGAI_CACHE_MAX_SIZE=1000
HGAI_SHQL_MAX_NODE_CANDIDATES=2000
HGAI_SHQL_MAX_EDGE_CANDIDATES=2000
HGAI_INFERENCE_MAX_FACT_EDGES=5000
HGAI_SHQL_JOIN_BATCH_SIZE=200

# ─── Telemetry (see docs/architect/telemetry-20260929061557.md) ─────────────
# Off by default. With no HGAI_TELEMETRY_ENDPOINT, telemetry is stored
# locally in the __local-telemetry hypergraph instead of being discarded.
HGAI_TELEMETRY_ENABLED=false
# HGAI_TELEMETRY_ENDPOINT=https://telemetry.hypergra.ai/report
HGAI_TELEMETRY_PROTOCOL=hgai-envelope
# HGAI_TELEMETRY_API_KEY=your-telemetry-endpoint-api-key
HGAI_TELEMETRY_BATCH_SIZE=100
HGAI_TELEMETRY_FLUSH_INTERVAL_SECONDS=10
HGAI_TELEMETRY_QUEUE_MAX_SIZE=10000
HGAI_TELEMETRY_LOCAL_ENABLED=false
HGAI_TELEMETRY_LOCAL_RETENTION_DAYS=30
HGAI_TELEMETRY_INCLUDE_GRAPH_IDS=false
HGAI_TELEMETRY_INCLUDE_ACCOUNT_IDS=false
HGAI_TELEMETRY_ALLOW_INSECURE=false
HGAI_TELEMETRY_SAMPLE_RATE=1.0
HGAI_TELEMETRY_ENVIRONMENT=production

# ─── CORS ───────────────────────────────────────────────────────────────────
HGAI_CORS_ORIGINS=*

# ─── Admin Bootstrap ────────────────────────────────────────────────────────
# Used only on first run to create the admin account
HGAI_ADMIN_USERNAME=admin
HGAI_ADMIN_PASSWORD=pwd357
HGAI_ADMIN_EMAIL=admin@hgai.local
